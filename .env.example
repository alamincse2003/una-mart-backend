# Copy to .env and fill in. Never commit .env.

# Local Docker database (docker compose up -d)
DATABASE_URL="postgresql://una:una_dev_password@localhost:55432/una_mart?schema=public"

# API server
PORT=4000
NODE_ENV=development

# Storefront origin allowed by CORS (comma-separated for several)
WEB_ORIGIN=http://localhost:3000

# Optional hard cap on Cash on Delivery orders, in poisha (e.g. 5000000 = BDT 50,000).
# Empty = no cap.
COD_MAX_ORDER_TOTAL=

# COD orders above this total (poisha) need OTP verification. Default 1000000 = BDT 10,000.
COD_OTP_THRESHOLD=1000000

# Secret for hashing OTP codes (32+ random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=change-me-to-32-plus-random-characters-please

# console = print OTP codes in the API log (dev only; refused in production).
SMS_PROVIDER=console
