// UNA Mart database schema. Models follow SYSTEM_DESIGN.md (frontend repo):
// UUID ids, money as integer poisha, timestamptz, archive instead of delete.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — phone-first (decision D3), server-side sessions (D4)
// ---------------------------------------------------------------------------

enum UserRole {
  customer
  admin
  seller // Phase 2

  @@map("user_role")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String?
  phone           String     @unique // E.164
  email           String?    @unique
  passwordHash    String?    @map("password_hash") // admins only for now
  role            UserRole   @default(customer)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]
  cart            Cart?
  orders          Order[]
  auditLogs       AuditLog[]

  @@map("user")
}

// customer = phone OTP login. admin = password + OTP admin login; only these
// sessions pass admin guards, even for a user whose role is admin.
enum SessionScope {
  customer
  admin

  @@map("session_scope")
}

// The browser holds only the raw token in an httpOnly cookie; the database
// stores its SHA-256, so a leaked table can't be replayed as sessions.
model Session {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      SessionScope @default(customer)
  tokenHash  String       @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

enum OtpPurpose {
  login
  checkout
  admin_login

  @@map("otp_purpose")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
  @@map("otp_code")
}

// ---------------------------------------------------------------------------
// Trust and safety
// ---------------------------------------------------------------------------

// Feeds the COD risk rules (SYSTEM_DESIGN.md). Counters are updated by
// OrdersService.transition when COD orders are delivered or refused.
model PhoneFlag {
  phone             String   @id // E.164
  codRefusedCount   Int      @default(0) @map("cod_refused_count")
  codDeliveredCount Int      @default(0) @map("cod_delivered_count")
  isBlocked         Boolean  @default(false) @map("is_blocked")
  note              String?
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("phone_flag")
}

// Every admin write (prices, stock, orders, categories, settings).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  parentId  String?    @map("parent_id") @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0) @map("sort_order")
  imageUrl  String?    @map("image_url")
  isActive  Boolean    @default(true) @map("is_active")
  products  Product[]

  @@index([parentId])
  @@map("category")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum ProductBadge {
  new
  sale
  best

  @@map("product_badge")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  slug         String           @unique
  description  String
  categoryId   String           @map("category_id") @db.Uuid
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand        String?
  status       ProductStatus    @default(draft)
  badge        ProductBadge?
  freeDelivery Boolean          @default(false) @map("free_delivery")
  // Denormalized from published reviews (reviews module comes later).
  ratingAvg    Decimal          @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount  Int              @default(0) @map("rating_count")
  sellerId     String?          @map("seller_id") @db.Uuid // Phase 2
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants     ProductVariant[]
  images       ProductImage[]

  @@index([categoryId, status])
  // Trigram indexes back ILIKE search on ?q= (needs the pg_trgm extension,
  // created in the catalog migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_description_trgm_idx")
  @@map("product")
}

// Price and stock live on the variant, never on the product. A simple
// product has one variant with options = {}.
model ProductVariant {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  options        Json            @default("{}")
  price          Int // poisha
  compareAtPrice Int?            @map("compare_at_price") // poisha, set only when discounted
  stockQty       Int             @default(0) @map("stock_qty")
  isActive       Boolean         @default(true) @map("is_active")
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@map("product_variant")
}

// NOTE: SYSTEM_DESIGN.md specifies `cloudinary_public_id`. Cloudinary isn't
// set up yet, so images are plain URLs/paths for now.
model ProductImage {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String          @default("")
  sortOrder Int             @default(0) @map("sort_order")

  @@index([productId])
  @@map("product_image")
}

// ---------------------------------------------------------------------------
// Inventory — StockMovement is an append-only ledger; ProductVariant.stockQty
// is the running total. Only the inventory module writes either.
// ---------------------------------------------------------------------------

enum StockReason {
  order
  cancel
  return
  restock
  adjustment

  @@map("stock_reason")
}

model StockMovement {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta     Int
  reason    StockReason
  refType   String?        @map("ref_type")
  refId     String?        @map("ref_id")
  actorId   String?        @map("actor_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([variantId, createdAt])
  @@map("stock_movement")
}

// ---------------------------------------------------------------------------
// Delivery — fees are data, not code, so they change without a deploy.
// ---------------------------------------------------------------------------

model DeliveryZone {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  fee       Int // poisha
  etaText   String  @map("eta_text")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  orders    Order[]

  @@map("delivery_zone")
}

// ---------------------------------------------------------------------------
// Shopping
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @unique @map("user_id") @db.Uuid // logged-in cart
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique @map("guest_token") // guest cart (cookie)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items      CartItem[]

  @@index([updatedAt])
  @@map("cart")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([cartId, variantId])
  @@map("cart_item")
}

// ---------------------------------------------------------------------------
// Orders — fulfilment status and payment status are separate fields.
// ---------------------------------------------------------------------------

enum OrderStatus {
  awaiting_payment
  pending_confirmation
  confirmed
  processing
  shipped
  delivered
  delivery_failed
  returned_to_warehouse
  cancelled

  @@map("order_status")
}

enum PaymentMethod {
  cod
  bkash
  nagad
  card

  @@map("payment_method")
}

enum PaymentStatus {
  unpaid
  pending
  paid
  partially_refunded
  refunded

  @@map("payment_status")
}

enum ActorType {
  customer
  admin
  system
  courier
  payment

  @@map("actor_type")
}

model Order {
  id              String             @id @default(uuid()) @db.Uuid
  orderNumber     String             @unique @map("order_number")
  userId          String?            @map("user_id") @db.Uuid // null = guest checkout
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String             @map("customer_name")
  phone           String // E.164
  // True when the phone was proven by OTP (at checkout or via login).
  phoneVerified   Boolean            @default(false) @map("phone_verified")
  email           String?
  shippingAddress Json               @map("shipping_address") // snapshot: { line1, area?, city }
  deliveryZoneId  String             @map("delivery_zone_id") @db.Uuid
  deliveryZone    DeliveryZone       @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  status          OrderStatus
  paymentMethod   PaymentMethod      @map("payment_method")
  paymentStatus   PaymentStatus      @default(unpaid) @map("payment_status")
  subtotal        Int // poisha
  discountTotal   Int                @default(0) @map("discount_total")
  deliveryFee     Int                @map("delivery_fee")
  total           Int
  customerNote    String?            @map("customer_note")
  adminNote       String?            @map("admin_note")
  placedAt        DateTime           @default(now()) @map("placed_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  items           OrderItem[]
  events          OrderStatusEvent[]
  payments        Payment[]

  @@index([phone])
  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@map("order")
}

// Everything copied at purchase time: editing a product never changes a
// past order.
model OrderItem {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String         @map("variant_id") @db.Uuid
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName  String         @map("product_name")
  variantLabel String         @default("") @map("variant_label")
  sku          String
  imageUrl     String?        @map("image_url")
  unitPrice    Int            @map("unit_price") // poisha
  quantity     Int
  lineTotal    Int            @map("line_total")
  sellerId     String?        @map("seller_id") @db.Uuid // Phase 2

  @@index([orderId])
  @@map("order_item")
}

model OrderStatusEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("order_status_event")
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

enum PaymentProvider {
  cod
  bkash
  nagad
  sslcommerz

  @@map("payment_provider")
}

enum PaymentAttemptStatus {
  initiated
  pending
  succeeded
  failed
  cancelled
  expired

  @@map("payment_attempt_status")
}

model Payment {
  id             String               @id @default(uuid()) @db.Uuid
  orderId        String               @map("order_id") @db.Uuid
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       PaymentProvider
  amount         Int // poisha
  status         PaymentAttemptStatus
  providerRef    String?              @map("provider_ref")
  idempotencyKey String               @unique @map("idempotency_key")
  rawResponse    Json?                @map("raw_response")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payment")
}
