# /opt/unamart/.env on the server — copy this file there and fill it in.
# NEVER commit the real file. Keep a copy in your password manager.
# Generate random values with:  openssl rand -hex 32

# Domain without "www" or "https://". Caddy serves www.<domain> and api.<domain>.
SITE_DOMAIN=unamartbd.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=info@unamartbd.com

# GitHub account or organization that owns the images (lowercase).
GHCR_OWNER=alamincse2003

# staging = private preview (OTP codes in the API log, site not indexed).
# production = public shop (requires a real SMS gateway).
APP_ENV=staging

# Database. Use hex values (no special characters to escape in URLs).
POSTGRES_USER=unamart
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=unamart

# API secrets and settings (see una-mart-backend/.env.example for meaning).
OTP_SECRET=change-me-openssl-rand-hex-32
SMS_PROVIDER=console
COD_OTP_THRESHOLD=1000000
COD_MAX_ORDER_TOTAL=

# Optional off-server backup target for rclone (e.g. "r2:unamart-backups").
# Empty = backups stay on this server only (not safe long-term).
BACKUP_REMOTE=
